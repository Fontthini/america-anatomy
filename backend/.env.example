# =============================================================================
# BASE BACKEND — variáveis de ambiente
# Copie este arquivo para .env e preencha cada valor antes de rodar o servidor.
# Nunca comite o arquivo .env. Nunca use os valores placeholder em produção.
# =============================================================================

# -----------------------------------------------------------------------------
# Identidade do projeto
# Mude APP_NAME a cada projeto novo criado a partir desta base.
# -----------------------------------------------------------------------------
APP_NAME="meu-projeto"
NODE_ENV="development"      # development | production | test
PORT=3001                   # Porta HTTP do servidor

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# Cada projeto deve ter o seu próprio banco (nunca compartilhar).
# Provedores: Railway, Neon, Supabase, Render, ou local.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# -----------------------------------------------------------------------------
# Segredos JWT — gere valores únicos para cada projeto:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Nunca reutilize segredos entre projetos.
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET="substitua-por-64-hex-chars-gerados-aleatoriamente-1"
JWT_REFRESH_SECRET="substitua-por-64-hex-chars-gerados-aleatoriamente-2"

# TTL dos tokens (formato: "15m", "1h", "7d", "3600s")
ACCESS_TOKEN_TTL="15m"      # Access token: curto (15 min recomendado)
REFRESH_TOKEN_TTL="7d"      # Refresh token: longo (7 dias recomendado)

# -----------------------------------------------------------------------------
# Cookies
# Usado para assinar os cookies de refresh token.
# Gere da mesma forma que os segredos JWT acima.
# -----------------------------------------------------------------------------
COOKIE_SECRET="substitua-por-64-hex-chars-gerados-aleatoriamente-3"

# -----------------------------------------------------------------------------
# CORS — origens permitidas (com credentials)
# Uma origem:    CORS_ORIGIN="http://localhost:3000"
# Múltiplas:     CORS_ORIGIN="http://localhost:3000,https://app.exemplo.com"
# Ajuste para a(s) URL(s) real(is) do seu front-end.
# -----------------------------------------------------------------------------
CORS_ORIGIN="http://localhost:3000"

# -----------------------------------------------------------------------------
# E-mail transacional (Resend)
# Gere sua API key em https://resend.com/api-keys
# Nunca comite a key real — deixe vazio aqui, preencha só no .env local.
# EMAIL_FROM requer um domínio verificado no Resend em produção.
# -----------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Base <no-reply@seudominio.com>"

# URL pública do front-end (usada nos links dos e-mails)
APP_URL="http://localhost:8080"

# -----------------------------------------------------------------------------
# Storage de arquivos (Bunny.net Edge Storage)
# 1. Crie uma Storage Zone em https://dash.bunny.net/storage
# 2. Crie um Pull Zone vinculado a ela (para servir arquivos publicamente)
# 3. Preencha as variáveis abaixo com os valores do painel
#
# BUNNY_STORAGE_REGION: endpoint da região da sua storage zone
#   Frankfurt (padrão): storage.bunnycdn.com
#   São Paulo (BR):     br.storage.bunnycdn.com
#   London (UK):        uk.storage.bunnycdn.com
#   New York (NY):      ny.storage.bunnycdn.com
#   Los Angeles (LA):   la.storage.bunnycdn.com
#   Singapore (SG):     sg.storage.bunnycdn.com
#   Stockholm (SE):     se.storage.bunnycdn.com
# -----------------------------------------------------------------------------
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_STORAGE_ZONE="nome-da-storage-zone"
BUNNY_STORAGE_REGION="storage.bunnycdn.com"
BUNNY_CDN_URL="https://meu-pullzone.b-cdn.net"
