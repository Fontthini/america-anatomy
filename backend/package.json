{
  "name": "backend",
  "version": "1.0.0",
  "description": "API REST para o lumina-ui (Fastify + TypeScript + Prisma + PostgreSQL)",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file=.env --import=tsx/esm --watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "seed": "node --env-file=.env --import=tsx/esm prisma/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.3",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.9.0",
    "argon2": "^0.43.1",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "resend": "^6.12.4",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.16.5",
    "eslint": "^9.32.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.7.3",
    "prisma": "^6.9.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.0"
  }
}
