// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DOCTOR
  SALES_REP
  MANAGER
  ADMIN
}

model User {
  id                String    @id @default(cuid())
  name              String
  email             String    @unique
  passwordHash      String
  avatarUrl         String?
  bio               String?
  role              Role      @default(DOCTOR)
  emailVerified      Boolean   @default(false)
  emailVerifiedAt    DateTime?
  passwordChangedAt  DateTime?
  emailNotifications Boolean   @default(true)
  productUpdates     Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  refreshTokens      RefreshToken[]
  verificationTokens VerificationToken[]
  passwordHistory    PasswordHistory[]
  notifications      Notification[]
  doctorProfile      DoctorProfile?  @relation("DoctorProfileUser")
  approvedDoctors     DoctorProfile[] @relation("DoctorApprovals")
  assignedLeads       DoctorProfile[] @relation("AssignedSalesRep")
  auditLogs           AuditLog[]
  financialEntries    FinancialEntry[]
}

enum ApprovalStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum FunnelStage {
  NEW
  FIRST_CONTACT
  AWAITING_RESPONSE
  INTERESTED
  PAYMENT_LINK_SENT
  CUSTOMER
  LOST
}

enum ReviewAction {
  APPROVE
  REJECT
}

model DoctorProfile {
  id               String         @id @default(cuid())
  userId           String         @unique
  crm              String?
  specialty        String?
  phone            String?
  clinicName       String?
  city             String?
  state            String?
  approvalStatus   ApprovalStatus @default(PENDING)
  approvedAt       DateTime?
  approvedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?

  // Funil de vendas — mesma ideia do peptideo: o estágio vive direto no cadastro do médico.
  funnelStage           FunnelStage   @default(NEW)
  lossReason            String?
  assignedSalesRepId    String?
  // Preenchido quando um SALES_REP solicita decisão (aprovar/rejeitar) de um MANAGER/ADMIN.
  reviewRequestedAction ReviewAction?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user            User      @relation("DoctorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy      User?     @relation("DoctorApprovals", fields: [approvedByUserId], references: [id])
  assignedSalesRep User?    @relation("AssignedSalesRep", fields: [assignedSalesRepId], references: [id])
  orders          Order[]
  referrals       Referral[]

  @@index([approvalStatus])
  @@index([funnelStage])
  @@index([assignedSalesRepId])
}

enum ReferralType {
  PATIENT
  DOCTOR
}

enum ReferralPatientStatus {
  IN_PROGRESS
  NEGOTIATION
  PAID
  CANCELLED
}

enum ReferralDoctorStatus {
  NEW
  CONTACTED
  CONVERTED
  REJECTED
}

model Referral {
  id                       String                  @id @default(cuid())
  referringDoctorProfileId String
  type                     ReferralType
  firstName                String
  lastName                 String
  whatsapp                 String
  email                    String?
  address                  String?
  crm                      String? // apenas type = DOCTOR
  patientStatus            ReferralPatientStatus? // apenas type = PATIENT
  doctorStatus             ReferralDoctorStatus? // apenas type = DOCTOR
  notes                    String?
  commissionAmount         Decimal?                @db.Decimal(10, 2)
  commissionPaid           Boolean                 @default(false)
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  referringDoctorProfile DoctorProfile @relation(fields: [referringDoctorProfileId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([referringDoctorProfileId])
}

enum FinancialEntryType {
  INCOME
  EXPENSE
}

model FinancialEntry {
  id              String             @id @default(cuid())
  type            FinancialEntryType
  category        String
  description     String
  amount          Decimal            @db.Decimal(10, 2)
  entryDate       DateTime
  receiptUrl      String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  createdBy User? @relation(fields: [createdByUserId], references: [id])

  @@index([type])
  @@index([entryDate])
}

model FinancialCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  actorLabel  String
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
}

enum CatalogItemType {
  PRODUCT
  COURSE
  SEMINAR
}

enum CatalogItemStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CatalogItem {
  id          String            @id @default(cuid())
  type        CatalogItemType
  status      CatalogItemStatus @default(DRAFT)
  title       String
  slug        String            @unique
  description String?
  imageUrl    String?
  price       Decimal?          @db.Decimal(10, 2)
  // Categoria livre (ex.: "Emagrecimento", "Anatomia Óssea") — só usada na Loja (PRODUCT), pills de filtro.
  category    String?

  // COURSE / SEMINAR apenas
  startsAt DateTime?
  endsAt   DateTime?
  location String?
  isOnline Boolean   @default(false)
  capacity Int?

  // PRODUCT apenas
  sku      String?
  stockQty Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders               Order[]
  courseRegistrations  CourseRegistration[]

  @@index([type, status])
}

enum CourseRegistrationStatus {
  NEW
  CONTACTED
  CONFIRMED
  DECLINED
}

/// Lead de interesse num curso/seminário via formulário público (sem login,
/// sem criar conta de médico) — usado por médicos parceiros que ainda não
/// têm cadastro na plataforma. Diferente de Order (que exige conta aprovada).
model CourseRegistration {
  id            String                    @id @default(cuid())
  catalogItemId String
  name          String
  email         String
  crm           String?
  whatsapp      String
  notes         String?
  status        CourseRegistrationStatus  @default(NEW)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId])
  @@index([status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  doctorProfileId String
  catalogItemId   String
  quantity        Int         @default(1)
  status          OrderStatus @default(CONFIRMED)
  unitPrice       Decimal?    @db.Decimal(10, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  doctorProfile DoctorProfile @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem   @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([catalogItemId])
  @@index([doctorProfileId])
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String
  passwordHash String
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum TokenType {
  CONFIRM_EMAIL
  RESET_PASSWORD
}

enum NotificationType {
  WELCOME
  EMAIL_VERIFIED
  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PROFILE_UPDATED
  AVATAR_UPDATED
  DOCTOR_REGISTRATION_RECEIVED
  NEW_DOCTOR_PENDING
  DOCTOR_APPROVED
  DOCTOR_REJECTED
  ORDER_CREATED
  LEAD_ASSIGNED
  LEAD_REVIEW_REQUESTED
  NEW_COURSE_REGISTRATION
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
